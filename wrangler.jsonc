{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hogiguru",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hogiguru",
      "database_id": "29dc5201-2f43-4bab-847c-b48931420325",
      "migrations_dir": "migrations"
    }
  ],
  // Varmistukset (yöllinen SQL-dump + tapahtumavarmistukset)
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "hogiguru-backups" }],
  // Sähköposti: RESEND_API_KEY asetetaan salaisuutena (wrangler secret put RESEND_API_KEY)
  "vars": { "MAIL_FROM": "HogiGuru <no-reply@konderi.fi>" },
  // Tilastopäivitys: tunnin välein (UTC)
  // Herätys 30 min välein; worker ajaa päivityksen vain Suomen aikaa klo 17.00–23.00 (30 min välein) sekä klo 05.00 ja 11.00.
  "triggers": { "crons": ["*/30 * * * *"] },
  "routes": [{ "pattern": "guru.konderi.fi", "custom_domain": true }],
  "observability": { "enabled": true }
}
